# ─────────────────────────────────────────────────────────────
# Corpo & Saúde — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha com os valores
# do seu projeto Supabase (Settings → API).
# NUNCA commite o `.env.local`.
# ─────────────────────────────────────────────────────────────

# Públicas (vão para o client — somente a anon key)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Servidor — NUNCA exponha no front-end nem commite.
# Usada apenas em rotinas/ações de servidor (ex.: criar acesso de aluno).
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta

# URL base do app (usada em e-mails de reset de senha, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
