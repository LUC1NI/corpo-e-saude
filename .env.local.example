# ─────────────────────────────────────────────────────────────
# Corpo & Saúde — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha com os valores
# do seu projeto Supabase (Settings → API).
# NUNCA commite o `.env.local`.
# ─────────────────────────────────────────────────────────────

# Públicas (vão para o client — somente a anon key)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Servidor — NUNCA exponha no front-end nem commite.
# Usada apenas em rotinas/ações de servidor (ex.: criar acesso de aluno).
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta

# URL base do app (usada em e-mails de reset de senha, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Conexão direta ao Postgres — usada SOMENTE para rodar migrations
# (npm run db:migrate). Use a string do "Session pooler" (porta 5432).
# Supabase → Settings → Database → Connection string → Session pooler.
SUPABASE_DB_URL=postgresql://postgres.SEU-REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# Segredo do cron de renovação automática (/api/cron/renovar).
# Gere um valor aleatório forte. Na Vercel, defina como env var: o Vercel Cron
# envia automaticamente este valor no header Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=troque-por-um-segredo-aleatorio-forte

# Web Push (notificações). Gere o par com: npx @pushforge/builder vapid
# A pública vai também no wrangler.jsonc (vars); a privada (JSON do JWK) só
# aqui e como secret no Cloudflare: npx wrangler secret put VAPID_PRIVATE_KEY
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
